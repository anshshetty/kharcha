# Optional environment variables for local launch. No credentials belong here.
MONTHLYCOST_PORT=8765
# Mobile HTTPS access is enabled by default, on the desktop port + 1.
# MONTHLYCOST_MOBILE_PORT=8766
# Disable for a launch/development without changing the saved Settings preference:
# MONTHLYCOST_MOBILE=0
# Default: ~/Library/Application Support/MonthlyCost
# MONTHLYCOST_DATA_DIR=/absolute/path/to/private/monthlycost-data
